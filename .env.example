# Public Supabase settings. The anon/publishable key is designed for the browser.
# Never put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Optional alias accepted by newer Supabase projects.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used for QR codes, NFC URLs, and invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Required only for `npm run seed:demo`. Never import this in app code.
SUPABASE_SERVICE_ROLE_KEY=

# Must be exactly "true" or the demo seed script exits.
# The script also refuses to run when VERCEL_ENV=production.
ALLOW_DEMO_SEED=false
